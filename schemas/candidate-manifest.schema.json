{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grippy98.github.io/ti-debpkgs-sandbox/schemas/candidate-manifest.schema.json",
  "title": "TI Debian build candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "producer", "source", "build", "publication", "files"],
  "properties": {
    "schema": {"const": "ti.debian.candidate/v1"},
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "workflow", "ref", "commit", "run_id", "run_attempt"],
      "properties": {
        "repository": {"type": "string"},
        "workflow": {"type": "string"},
        "ref": {"type": "string"},
        "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "run_id": {"type": "integer", "minimum": 1},
        "run_attempt": {"type": "integer", "minimum": 1}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "upstream_repository", "upstream_commit"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9+.-]+$"},
        "version": {"type": "string", "minLength": 1},
        "upstream_repository": {"type": "string", "format": "uri"},
        "upstream_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suite", "binary_architectures", "changes_distribution"],
      "properties": {
        "suite": {"type": "string"},
        "binary_architectures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "changes_distribution": {"type": "string", "minLength": 1}
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suites", "component"],
      "properties": {
        "suites": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string"}
        },
        "component": {"type": "string"}
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "sha256"],
        "properties": {
          "path": {"type": "string", "pattern": "^payload/[A-Za-z0-9][A-Za-z0-9+._~-]*$"},
          "size": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
